# ---- Backend environment variables (example) ----
# Copy to .env and fill in real values. NEVER commit the real .env.

# Option A: full database URL (used by Render / Railway / Fly.io)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B: individual parts (used by docker-compose locally)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=inventory

# Comma separated list of allowed frontend origins, or * for all.
# In production set this to your deployed frontend URL, e.g.
# CORS_ORIGINS=https://your-frontend.vercel.app
CORS_ORIGINS=*
