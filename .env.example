# ---- Root environment for docker-compose (example) ----
# Copy to .env:   cp .env.example .env
# Then change POSTGRES_PASSWORD to something secret. NEVER commit the real .env.

# Database credentials (shared by the db and backend services)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_secret
POSTGRES_DB=inventory

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS: which frontend origins the backend accepts. For local dev the
# frontend runs at http://localhost:3000.
CORS_ORIGINS=http://localhost:3000

# The URL the browser uses to reach the backend (baked into the frontend build).
FRONTEND_API_URL=http://localhost:8000
